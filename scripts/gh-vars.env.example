# Shared GitHub Actions variables — uploaded to ALL three deepCab repos.
# Copy to gh-vars.env (gitignored) and fill in real values.
GCP_PROJECT=deepcab-dev
GCP_PROJECT_NUMBER=000000000000
GCP_REGION=us-central1
GCP_WIF_PROVIDER=projects/000000000000/locations/global/workloadIdentityPools/github-pool/providers/github-provider
GCP_DEPLOYER_SA=deepcab-deployer@deepcab-dev.iam.gserviceaccount.com
